{
  "name": "moons-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-mediapipe.mjs",
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "start:host": "next start -H 0.0.0.0 -p 3000",
    "smoke": "node --env-file=.env.local --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@mediapipe/tasks-vision": "0.10.35",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
